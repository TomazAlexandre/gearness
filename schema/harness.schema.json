{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TomazAlexandre/gearness/main/schema/harness.schema.json",
  "title": "gearness harness.yaml",
  "description": "Declarative description of a repository's AI agent harness. Docs: https://github.com/TomazAlexandre/gearness/blob/main/docs/configuration.md",
  "type": "object",
  "required": [
    "version",
    "project"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Schema version."
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "One paragraph: what the project does, for whom, what must never break."
        }
      }
    },
    "stack": {
      "enum": [
        "node",
        "python",
        "go",
        "java",
        "rust",
        "dotnet",
        "generic"
      ]
    },
    "commands": {
      "type": "object",
      "description": "How agents verify work. `test` and `lint`/`typecheck` are expected.",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "install": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "default": "AGENTS.md",
          "description": "Single source of truth for agent instructions."
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deeper docs linked from the entry file."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "default": "docs/STATUS.md",
          "description": "Handoff file between sessions."
        },
        "maxEntryLines": {
          "type": "integer",
          "minimum": 10,
          "default": 150
        },
        "maxEntryTokens": {
          "type": "integer",
          "minimum": 10,
          "default": 2500
        }
      }
    },
    "agents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "cursor",
          "copilot",
          "codex",
          "gemini",
          "windsurf",
          "cline"
        ]
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 70
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rule ids to skip (see `gearness rules`)."
        }
      }
    },
    "boundaries": {
      "type": "array",
      "description": "Architecture rules checked against real imports (TS/JS, Python, Go, Java, Kotlin, C#).",
      "items": {
        "type": "object",
        "required": [
          "from",
          "deny"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "description": "Glob of files the rule applies to, e.g. src/ui/**"
          },
          "deny": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            ],
            "description": "Globs of paths or package names those files must not import."
          },
          "except": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Globs of files exempt from this boundary, e.g. tests that reach across layers."
          },
          "message": {
            "type": "string",
            "description": "Why the boundary exists; shown to agents."
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Monorepo packages (globs) with their own harness.yaml."
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "npm packages that export extra rules."
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "default": "claude",
          "description": "Preset (claude, codex, aider, gemini) or a shell command containing {prompt}.",
          "examples": [
            "claude",
            "codex",
            "aider",
            "gemini",
            "my-agent --task {prompt}"
          ]
        },
        "tasks": {
          "type": "string",
          "default": ".harness/evals"
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 900
        }
      }
    }
  }
}
